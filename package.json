{
  "name": "solid-que",
  "version": "0.1.0",
  "private": true,
  "description": "Local video review/queue/publish app for Solid Plumbing & Electrical content pipeline",
  "type": "commonjs",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsc -p tsconfig.json --watch",
    "dev:run": "node --watch dist/server.js"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-session": "^1.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.6.3"
  }
}
