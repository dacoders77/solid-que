# Server
PORT=8787
SESSION_SECRET=change-me-to-a-long-random-string

# Single-user login
AUTH_USERNAME=admin
# Generate with: node dist/scripts/hash-password.js "your-password-here"
AUTH_PASSWORD_HASH=

# Storage — files are referenced in place (never moved/copied), only the
# app's own database lives here.
DB_PATH=./data/solid-que.db

# Shared secret for machine callers (render pipeline ingest, Claude publish
# worker) — sent as the X-Service-Token header. Generate any long random string.
SERVICE_TOKEN=
