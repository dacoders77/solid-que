# Server
PORT=8787
SESSION_SECRET=change-me-to-a-long-random-string

# Single-user login
AUTH_USERNAME=admin
# Generate with: node dist/scripts/hash-password.js "your-password-here"
AUTH_PASSWORD_HASH=

# Storage — files are referenced in place (never moved/copied), only the
# app's own database lives here.
DB_PATH=./data/solid-que.db

# Shared secret for machine callers (render pipeline ingest, Claude publish
# worker) — sent as the X-Service-Token header. Generate any long random string.
SERVICE_TOKEN=

# Public URL external services (Metricool) can reach this app through, e.g.
# a Cloudflare quick tunnel: `cloudflared tunnel --url http://localhost:8787`
# Leave empty if not set up yet — the publish worker will skip media it
# can't expose publicly rather than guess a URL.
PUBLIC_BASE_URL=
